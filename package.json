  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.2.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check proactive.js && node --check memory-client.js && node --check config.js && node --check session-store.js && node --check main-session.js && node --check magic.js && node --check magic-tools.js && node --check spell-runner.js && node --check spell-library.js && node --check task-store.js && node --check task-tools.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.2.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
