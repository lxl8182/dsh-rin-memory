  },
  "files": [
    "index.js",
    "schema.js",
    "memory-client.js",
    "proactive.js",
    "config.js",
    "session-store.js",
    "main-session.js",
    "magic.js",
    "magic-tools.js",
    "spell-runner.js",
    "spell-library.js",
